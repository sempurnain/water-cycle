rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable security primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'schoolName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'schoolName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClass(data) {
      return data.keys().hasAll(['teacherId', 'name', 'grade', 'academicYear', 'studentCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'name', 'grade', 'academicYear', 'studentCount', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 40
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.studentCount is int && data.studentCount >= 0 && data.studentCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['teacherId', 'classId', 'nickname', 'studentNumber', 'totalScore', 'totalStars', 'level', 'evaluationAverage', 'missionsCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'classId', 'nickname', 'studentNumber', 'totalScore', 'totalStars', 'level', 'evaluationAverage', 'missionsCompleted', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && isValidId(data.classId)
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 60
        && data.studentNumber is string && data.studentNumber.size() >= 1 && data.studentNumber.size() <= 20
        && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 1000000
        && data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 10000
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.evaluationAverage is int && data.evaluationAverage >= 0 && data.evaluationAverage <= 100
        && data.missionsCompleted is int && data.missionsCompleted >= 0 && data.missionsCompleted <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['teacherId', 'classId', 'sessionCode', 'title', 'mode', 'activityType', 'status', 'currentStep', 'allowFreeAccess', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'classId', 'sessionCode', 'title', 'mode', 'activityType', 'status', 'currentStep', 'allowFreeAccess', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && isValidId(data.classId)
        && data.sessionCode is string && data.sessionCode.size() >= 4 && data.sessionCode.size() <= 12 && data.sessionCode.matches('^[A-Z0-9]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.mode in ['solo', 'duel', 'squad']
        && data.activityType in ['arrange', 'match', 'build', 'save-aqua', 'simulator']
        && data.status in ['waiting', 'active', 'paused', 'completed']
        && data.currentStep is int && data.currentStep >= 0 && data.currentStep <= 100
        && data.allowFreeAccess is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['teacherId', 'sessionId', 'displayName', 'role', 'score', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'sessionId', 'displayName', 'role', 'score', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && isValidId(data.sessionId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 32
        && data.score is int && data.score >= 0 && data.score <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttempt(data) {
      return data.keys().hasAll(['teacherId', 'classId', 'studentId', 'type', 'title', 'score', 'maxScore', 'correctCount', 'wrongCount', 'createdAt'])
        && data.keys().hasOnly(['teacherId', 'classId', 'studentId', 'type', 'title', 'score', 'maxScore', 'correctCount', 'wrongCount', 'createdAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && isValidId(data.classId)
        && isValidId(data.studentId)
        && data.type in ['game', 'evaluation', 'mission']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.score is int && data.score >= 0 && data.score <= 100000
        && data.maxScore is int && data.maxScore >= 1 && data.maxScore <= 100000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500
        && data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 500
        && data.createdAt is timestamp;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'missionId', 'completed', 'bestScore', 'stars', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'studentId', 'missionId', 'completed', 'bestScore', 'stars', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && isValidId(data.studentId)
        && data.missionId is string && data.missionId.size() >= 1 && data.missionId.size() <= 80
        && data.completed is bool
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 100000
        && data.stars is int && data.stars >= 0 && data.stars <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'badgeId', 'title', 'createdAt'])
        && data.keys().hasOnly(['teacherId', 'studentId', 'badgeId', 'title', 'createdAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && isValidId(data.studentId)
        && data.badgeId is string && data.badgeId.size() >= 1 && data.badgeId.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['teacherId', 'type', 'topic', 'prompt', 'options', 'correctAnswer', 'explanation', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'type', 'topic', 'prompt', 'options', 'correctAnswer', 'explanation', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId)
        && data.teacherId == request.auth.uid
        && data.type in ['multiple-choice', 'true-false', 'matching', 'diagram-fill']
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 60
        && data.prompt is string && data.prompt.size() >= 3 && data.prompt.size() <= 400
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
        && data.options[0] is string && data.options[0].size() >= 1 && data.options[0].size() <= 240
        && data.correctAnswer is string && data.correctAnswer.size() >= 1 && data.correctAnswer.size() <= 240
        && data.explanation is string && data.explanation.size() >= 3 && data.explanation.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /teachers/{teacherId} {
      allow get: if isSignedIn() && isValidId(teacherId) && request.auth.uid == teacherId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(teacherId) && request.auth.uid == teacherId
        && isValidTeacher(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(teacherId) && request.auth.uid == teacherId
        && isValidTeacher(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolName', 'updatedAt']);
      allow delete: if false;
    }

    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(classId)
        && isValidClass(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(classId)
        && existing().teacherId == request.auth.uid
        && isValidClass(incoming())
        && incoming().teacherId == existing().teacherId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'grade', 'academicYear', 'studentCount', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(classId) && existing().teacherId == request.auth.uid;
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(studentId)
        && isValidStudent(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && get(/databases/$(database)/documents/classes/$(incoming().classId)).data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(studentId)
        && existing().teacherId == request.auth.uid
        && isValidStudent(incoming())
        && incoming().teacherId == existing().teacherId
        && incoming().classId == existing().classId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'studentNumber', 'totalScore', 'totalStars', 'level', 'evaluationAverage', 'missionsCompleted', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(studentId) && existing().teacherId == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId)
        && isValidSession(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && get(/databases/$(database)/documents/classes/$(incoming().classId)).data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(sessionId)
        && existing().teacherId == request.auth.uid
        && existing().status != 'completed'
        && isValidSession(incoming())
        && incoming().teacherId == existing().teacherId
        && incoming().classId == existing().classId
        && incoming().sessionCode == existing().sessionCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'activityType', 'status', 'currentStep', 'allowFreeAccess', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(sessionId) && existing().teacherId == request.auth.uid;
    }

    match /session_participants/{participantId} {
      allow get: if isSignedIn() && isValidId(participantId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(participantId)
        && isValidParticipant(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/sessions/$(incoming().sessionId))
        && get(/databases/$(database)/documents/sessions/$(incoming().sessionId)).data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(participantId)
        && existing().teacherId == request.auth.uid
        && isValidParticipant(incoming())
        && incoming().teacherId == existing().teacherId
        && incoming().sessionId == existing().sessionId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'score', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(participantId) && existing().teacherId == request.auth.uid;
    }

    match /attempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(attemptId)
        && isValidAttempt(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && get(/databases/$(database)/documents/classes/$(incoming().classId)).data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }

    match /progress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(progressId)
        && isValidProgress(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(progressId)
        && existing().teacherId == request.auth.uid
        && isValidProgress(incoming())
        && incoming().teacherId == existing().teacherId
        && incoming().studentId == existing().studentId
        && incoming().missionId == existing().missionId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'bestScore', 'stars', 'updatedAt']);
      allow delete: if false;
    }

    match /achievements/{achievementId} {
      allow get: if isSignedIn() && isValidId(achievementId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(achievementId)
        && isValidAchievement(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId) && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(questionId)
        && isValidQuestion(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(questionId)
        && existing().teacherId == request.auth.uid
        && isValidQuestion(incoming())
        && incoming().teacherId == existing().teacherId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'topic', 'prompt', 'options', 'correctAnswer', 'explanation', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(questionId) && existing().teacherId == request.auth.uid;
    }
  }
}
